{
  "name": "companion-module-spresenter-pulse-fx",
  "version": "1.0.4",
  "description": "Controle do Pulse FX no Spresenter pelo Bitfocus Companion.",
  "main": "dist/main.js",
  "type": "module",
  "license": "MIT",
  "author": "Ariel Laureano Rosas",
  "homepage": "https://github.com/ariellaureanorosas/companion-module-spresenter-pulse-fx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariellaureanorosas/companion-module-spresenter-pulse-fx.git"
  },
  "bugs": {
    "url": "https://github.com/ariellaureanorosas/companion-module-spresenter-pulse-fx/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "manifest": "companion-module-check",
    "package": "npm run build && companion-module-build",
    "verify": "npm run check && npm run test && npm run build && npm run manifest"
  },
  "dependencies": {
    "@companion-module/base": "~2.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@companion-module/tools": "^3.2.0",
    "@types/node": "^24.10.0",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
